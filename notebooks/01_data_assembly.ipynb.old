{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "59d777c2",
   "metadata": {},
   "source": [
    "# 01 — Data assembly\n",
    "\n",
    "**Mini Project 2.** Reads the 2023 Census totals-by-topic households export,\n",
    "renames the variable columns using the Stats NZ lookup table, derives the\n",
    "crowding target, and writes one tidy analysis table — one row per statistical\n",
    "area 2 (SA2).\n",
    "\n",
    "Runs top to bottom on a fresh clone. Nothing here is analysis; it is the\n",
    "plumbing, and it should be dull.\n",
    "\n",
    "The lookup table is **not joined** to the data. It is used to rename columns,\n",
    "which is what makes 261 columns called `VAR_4_n` readable."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "91b42d48",
   "metadata": {},
   "source": [
    "## Setup"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7459f7fd-872b-4ed7-8b0c-359c096e135f",
   "metadata": {},
   "source": [
    "The setup (imports, paths, load_raw, read_measure, slug)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "ae71de63",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "data folder   : D:\\dsai\\dsai_projects\\Mini-Project-2-Data\n",
      "households ok : True\n",
      "lookup ok     : True\n"
     ]
    }
   ],
   "source": [
    "import re, json, warnings\n",
    "from pathlib import Path\n",
    "import numpy as np, pandas as pd\n",
    "\n",
    "warnings.filterwarnings(\"ignore\", category=pd.errors.PerformanceWarning)\n",
    "\n",
    "DATA = Path(r\"D:\\dsai\\dsai_projects\\Mini-Project-2-Data\")\n",
    "OUT  = Path(\"..\") / \"outputs\"\n",
    "OUT.mkdir(exist_ok=True, parents=True)\n",
    "\n",
    "HOUSEHOLDS_FILE = DATA / \"2023-census-totals-by-topic-for-households-by-statistical-ar.csv\"\n",
    "LOOKUP_FILE     = DATA / \"2023_census_totals_by_topic_for_households_by_sa2_lookup_table.csv\"\n",
    "SA2_SHAPE       = DATA / \"statistical-area-2-2023-generalised.shp\"\n",
    "RURAL_URBAN     = DATA / \"urban-rural-2026.shp\"\n",
    "SENTINEL = -999\n",
    "YEAR     = 2023\n",
    "\n",
    "def load_raw(path):\n",
    "    for enc in (\"utf-8-sig\", \"utf-8\", \"cp1252\"):\n",
    "        try:\n",
    "            return pd.read_csv(path, encoding=enc)\n",
    "        except UnicodeDecodeError:\n",
    "            continue\n",
    "    raise UnicodeDecodeError(path.name)\n",
    "\n",
    "def read_measure(series):\n",
    "    s = series.astype(str).str.strip()\n",
    "    s = s.str.replace(\",\", \"\", regex=False)\n",
    "    s = s.str.replace(r\"^\\$\", \"\", regex=True)\n",
    "    s = s.str.replace(r\"[%]$\", \"\", regex=True)\n",
    "    s = s.replace({\"\": None, \"..\": None, \"...\": None, \"c\": None, \"C\": None,\n",
    "                   \"-\": None, \"n/a\": None, \"N/A\": None, \"na\": None, \"NA\": None,\n",
    "                   \"null\": None, \"Null\": None})\n",
    "    return pd.to_numeric(s, errors=\"coerce\").replace(SENTINEL, np.nan)\n",
    "\n",
    "def slug(value):\n",
    "    return re.sub(r\"[^a-z0-9]+\", \"_\", str(value).lower()).strip(\"_\")\n",
    "\n",
    "print(\"data folder   :\", DATA)\n",
    "print(\"households ok :\", HOUSEHOLDS_FILE.exists())\n",
    "print(\"lookup ok     :\", LOOKUP_FILE.exists())\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "97c3a7c4",
   "metadata": {},
   "source": [
    "## Loading and renaming:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "ea7c5673",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "rows, columns : (2395, 93)\n",
      "rate dtype    : object\n",
      "\n",
      "count     2283.0\n",
      "unique    1589.0\n",
      "top          0.0\n",
      "freq        36.0\n",
      "\n",
      "usable rates  : 2283 of 2395\n",
      "threshold     : 0.0775\n",
      "base rate     : 0.2505\n",
      "\n",
      "written       : ..\\outputs\\analysis_frame.csv\n"
     ]
    }
   ],
   "source": [
    "households = load_raw(HOUSEHOLDS_FILE)\n",
    "lookup     = load_raw(LOOKUP_FILE)\n",
    "\n",
    "# The lookup describes 2013, 2018 and 2023 stacked together — keep 2023 only.\n",
    "lookup_2023 = lookup[(lookup[\"Year\"] == YEAR) &\n",
    "                     lookup[\"Column_name\"].astype(str).str.startswith(\"VAR_\")].copy()\n",
    "\n",
    "lookup_2023[\"readable_name\"] = [\n",
    "    f\"{slug(topic)}_{slug(category)}\"\n",
    "    for topic, category in zip(lookup_2023[\"Variable1\"], lookup_2023[\"Variable1_category\"])\n",
    "]\n",
    "rename_columns = dict(zip(lookup_2023[\"Column_name\"], lookup_2023[\"readable_name\"]))\n",
    "\n",
    "keep = [c for c in rename_columns if c in households.columns]\n",
    "analysis = (households[[\"SA22023_V1_00\", \"SA22023_V1_00_NAME\"] + keep]\n",
    "              .rename(columns={\"SA22023_V1_00\": \"sa2_code\",\n",
    "                               \"SA22023_V1_00_NAME\": \"sa2_name\"})\n",
    "              .rename(columns=rename_columns))\n",
    "\n",
    "value_columns = [c for c in analysis.columns if c not in (\"sa2_code\", \"sa2_name\")]\n",
    "analysis[value_columns] = analysis[value_columns].apply(read_measure).astype(\"float64\")\n",
    "analysis = analysis.copy()\n",
    "\n",
    "analysis[\"crowded_count\"]  = analysis[\"household_crowding_index_crowded\"]\n",
    "analysis[\"crowding_base\"]  = analysis[\"household_crowding_index_total_stated\"]\n",
    "analysis[\"crowding_rate\"]  = analysis[\"crowded_count\"] / analysis[\"crowding_base\"].replace(0, pd.NA)\n",
    "\n",
    "threshold = analysis[\"crowding_rate\"].quantile(0.75)\n",
    "analysis[\"crowded_top_quartile\"] = (analysis[\"crowding_rate\"] >= threshold).astype(\"float64\")\n",
    "analysis.loc[analysis[\"crowding_rate\"].isna(), \"crowded_top_quartile\"] = np.nan\n",
    "\n",
    "print(\"rows, columns :\", analysis.shape)\n",
    "print(\"rate dtype    :\", analysis[\"crowding_rate\"].dtype)\n",
    "print()\n",
    "print(analysis[\"crowding_rate\"].describe().round(4).to_string())\n",
    "print()\n",
    "print(\"usable rates  :\", analysis[\"crowding_rate\"].notna().sum(), \"of\", len(analysis))\n",
    "print(\"threshold     :\", round(threshold, 4))\n",
    "print(\"base rate     :\", round(analysis[\"crowded_top_quartile\"].mean(), 4))\n",
    "\n",
    "analysis.to_csv(OUT / \"analysis_frame.csv\", index=False)\n",
    "print()\n",
    "print(\"written       :\", OUT / \"analysis_frame.csv\")\n"
   ]
  },
